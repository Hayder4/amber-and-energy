# PostgreSQL connection string. Get a free one from Neon (neon.tech), Vercel Postgres,
# or Prisma Postgres — or run one locally with Docker: `docker run -p 5432:5432 -e
# POSTGRES_PASSWORD=postgres postgres:16` then DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Secret used to sign session JWTs. Generate your own with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# Comma-separated emails that are always granted the ADMIN role on register/login.
ADMIN_EMAILS="amberandenergy@yahoo.com"

NEXT_PUBLIC_SITE_NAME="Amber & Energy"
NEXT_PUBLIC_CURRENCY="SAR"
